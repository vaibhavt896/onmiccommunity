# Postgres (Neon or Supabase connection string; use the pooled URL on Vercel)
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/onmic

# Signs pass tokens and staff sessions. openssl rand -hex 32
TOKEN_SECRET=

# Salt for hashing staff PINs. openssl rand -hex 16
# Changing it invalidates every staff PIN.
STAFF_PIN_SALT=

# Community UPI account (placeholder until Vaibhav confirms)
NEXT_PUBLIC_UPI_ID=onmic@upi
NEXT_PUBLIC_UPI_NAME=On Mic Community

# Public site URL, used in pass links, WhatsApp messages and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Community links (the real On Mic accounts; override only if they change)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/on_mic_community/
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/KvublhQ8R6z0PC5lkhhqvb

# Google Sheets copy of the forms (optional: if unset the site works and skips the sheet).
# Setup: integrations/google-sheets/README.md. Never commit real values or prefix with NEXT_PUBLIC_.
GOOGLE_SHEET_ID=1ZwNLGliOkhG6dua-EwA-EQw5vBtP_llF1dnSylkOppE
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# One line with literal \n sequences, inside double quotes: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_WAITLIST_TAB=Waitlist
GOOGLE_SHEET_PERFORMER_TAB=Performers
# Live booking rows (created automatically). Set to "off" to disable.
GOOGLE_SHEET_BOOKINGS_TAB=Jam Bookings
